{
	"name": "PL_SOURCE_TO_SILVER_INNER",
	"properties": {
		"activities": [
			{
				"name": "Read table details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.table_config where table_id=@{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSQLDBDS",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "start_time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "source to landing ingestion",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Read table details",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "select * from PUBLIC.@{activity('Read table details').output.firstRow.source_table_name}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "caresyncpostgresDS",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "caresyncadlsDS",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": {
								"value": "@concat(\n    activity('Read table details').output.firstRow.source_system,\n    '/',\n    activity('Read table details').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "LandingtoBronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "source to landing ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/19b91a0388@srkrec.ac.in/Caresync-repo/Caresync-adb-repo/LandingTO_Bronze",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('start_time')",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read table details').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"source_system": {
							"value": "@activity('Read table details').output.firstRow.source_system",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "DatabricksCaresyncLS",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "BronzetoSilver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "LandingtoBronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/19b91a0388@srkrec.ac.in/Caresync-repo/Caresync-adb-repo/bronzeTO_Silver",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('start_time')",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read table details').output.firstRow.silver_table_name",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "DatabricksCaresyncLS",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update Success status",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "BronzetoSilver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDBCaresyncLS",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update  ctrl.audit_log set status='SUCCESS',end_time=SYSUTCDATETIME(),records_written=@{activity('BronzetoSilver').output.runOutput}\nWHERE adf_run_id='@{pipeline().parameters.adf_run_id}' and table_id=@{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			},
			"adf_run_id": {
				"type": "string",
				"defaultValue": "a1"
			}
		},
		"variables": {
			"start_time": {
				"type": "String"
			}
		},
		"annotations": []
	}
}